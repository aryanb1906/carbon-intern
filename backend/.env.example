# ── Django ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8000
DJANGO_SETTINGS_MODULE=config.settings

# Mail (console backend for local dev). Replace in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=webmaster@localhost

# Optional Sentry DSN (leave empty to disable)
SENTRY_DSN=

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://carbontrace:carbontrace@db:5432/carbontrace
CONN_MAX_AGE=60

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── ESG Settings ───────────────────────────────────────────────────────────────
EMISSION_FACTOR_VERSION=IPCC_AR6_2021
ANOMALY_SIGMA_THRESHOLD=3.0
MAX_UPLOAD_SIZE_MB=50

# ── Logging ────────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
